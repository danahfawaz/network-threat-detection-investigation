# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Streamlit local secrets (never commit)
.streamlit/secrets.toml

# Generated outputs (reports and exports are created on demand)
output/
reports/
*.html.tmp

# Local captures you analyze yourself - keep them out of the public repo.
# Only the synthetic files in samples/ are tracked.
*.pcap
*.pcapng
*.cap
!samples/*.pcap
!samples/*.pcapng

# OS / editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
